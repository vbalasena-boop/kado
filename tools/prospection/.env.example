# ============================================================================
#  Agent de prospection Kado — variables d'environnement
#  Copie ce fichier en .env et remplis les valeurs.  ->  cp .env.example .env
# ============================================================================

# ----- Google Places API (pour trouver les commerces + leur note/avis/site) -----
# 1. Va sur https://console.cloud.google.com/  ->  crée un projet (gratuit)
# 2. Active "Places API"  (APIs & Services > Library > Places API > Enable)
# 3. Crée une clé API (APIs & Services > Credentials > Create credentials > API key)
# Un crédit gratuit de 200 $/mois est offert : en pratique 0 € pour cet usage.
GOOGLE_PLACES_API_KEY=

# ----- Resend (pour envoyer les e-mails) -----
# 1. Crée un compte gratuit sur https://resend.com (100 mails/jour offerts)
# 2. Ajoute et VÉRIFIE ton domaine (Domains > Add) pour une bonne délivrabilité
#    (à défaut de domaine, tu peux tester avec onboarding@resend.dev en expéditeur)
# 3. Crée une clé API (API Keys > Create)
RESEND_API_KEY=

# Adresse expéditrice (doit appartenir à un domaine vérifié dans Resend)
FROM_EMAIL=prospection@ton-domaine.fr

# ----- Identité de l'expéditeur (OBLIGATOIRE — exigence RGPD d'identification) -----
SENDER_NAME=Ton Prénom Nom
SENDER_BUSINESS=Kado
# Adresse où le commerçant peut te répondre (et se désinscrire en répondant STOP)
REPLY_EMAIL=bonjour@ton-domaine.fr

# ----- Réglages -----
# Nombre maximum de mails envoyés par exécution / par jour
DAILY_LIMIT=5
# Hypothèse de projection : avis récoltés par jour de jeu (sert au calcul "~N avis en 90 j")
PROJECTION_PER_DAY=1
# Lien vers une démo / page du jeu (optionnel, ajouté dans le mail s'il est renseigné)
DEMO_URL=

# Mets true pour SIMULER l'envoi (rien n'est réellement envoyé) — utile pour tester
DRY_RUN=false
