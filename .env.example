# ----- Supabase (à récupérer dans ton projet Supabase > Settings > API) -----
# URL du projet, ex: https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Clé "service_role" (SECRÈTE — uniquement côté serveur, jamais dans le navigateur)
SUPABASE_SERVICE_ROLE_KEY=

# Les 2 valeurs ci-dessous servent à la connexion des commerçants (Auth).
# Même URL que ci-dessus, mais accessible au navigateur :
NEXT_PUBLIC_SUPABASE_URL=
# Clé "anon" (publique, sans danger côté navigateur) :
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----- Sécurité du cookie joueur (mets une longue chaîne aléatoire quelconque) -----
PLAYER_COOKIE_SECRET=change-moi-par-une-longue-chaine-aleatoire

# ----- Admin : e-mail(s) autorisé(s) à accéder à /admin (séparés par des virgules) -----
# Connecte-toi avec cet e-mail via le lien magique pour gérer les comptes.
ADMIN_EMAILS=ton-email@exemple.fr

# ----- E-mails (Resend) : invitations, campagnes, envoi du code cadeau au joueur -----
# Clé API Resend (https://resend.com > API Keys). Sans elle, aucun e-mail n'est envoyé.
RESEND_API_KEY=
# Adresse expéditrice par défaut (doit appartenir à un domaine VÉRIFIÉ dans Resend),
# ex: "Kado <bonjour@ton-domaine.fr>". À défaut, repli sur "Kado <bonjour@kado-app.fr>".
EMAIL_FROM=
# Optionnel : adresse dédiée aux e-mails marketing (campagnes) pour séparer les
# réputations d'envoi. Repli sur EMAIL_FROM si non renseignée.
EMAIL_FROM_MARKETING=

# ----- Cron (OBLIGATOIRE en production) -----
# Secret partagé avec les crons Vercel. Vercel envoie "Authorization: Bearer <ce
# secret>" automatiquement quand la variable est définie. Sans lui, les endpoints
# /api/cron/* REFUSENT de s'exécuter (fail-closed) — mets une longue chaîne aléatoire.
CRON_SECRET=change-moi-par-une-longue-chaine-aleatoire

# ----- Optionnel -----
# URL publique du site (utile pour générer les QR codes), ex: https://kado.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Prospection (optionnel) -----
# Clé API Google Places (côté serveur uniquement) pour le sourcing des commerces.
# Sans elle, le module de prospection fonctionne en MODE DÉMO (données factices).
# Crée-la dans Google Cloud Console → active "Places API (New)".
GOOGLE_PLACES_API_KEY=

# --- Envoi email de prospection (cold email) ---
# IMPORTANT : NE PAS utiliser Resend ni le domaine de Kado pour la prospection.
# Utilise un DOMAINE SÉPARÉ + un SMTP dédié (ou un outil cold email).
# Sans PROSPECT_SMTP_HOST, l'envoi est en MODE SIMULATION (rien n'est envoyé).
PROSPECT_EMAIL_FROM=          # ex: "Kado <hello@essayer-kado.fr>" (domaine séparé)
PROSPECT_REPLY_TO=            # ex: hello@essayer-kado.fr (boîte de réponse)
PROSPECT_SMTP_HOST=           # ex: smtp.votre-fournisseur.fr
PROSPECT_SMTP_PORT=587
PROSPECT_SMTP_SECURE=false    # true si port 465
PROSPECT_SMTP_USER=
PROSPECT_SMTP_PASS=
MAX_PROSPECT_EMAILS_PER_DAY=20   # plafond quotidien (warm-up, cadence lente)
PROSPECT_UNSUB_SECRET=        # secret pour signer les liens de désinscription (optionnel)

# --- Détection automatique des réponses (IMAP, optionnel) ---
# Lit la boîte de prospection pour marquer les prospects qui ont répondu.
# Si non défini, réutilise PROSPECT_SMTP_USER/PASS. Serveur OVH : ssl0.ovh.net:993.
PROSPECT_IMAP_HOST=          # ex: ssl0.ovh.net (défaut = PROSPECT_SMTP_HOST)
PROSPECT_IMAP_PORT=993
PROSPECT_IMAP_USER=          # défaut = PROSPECT_SMTP_USER
PROSPECT_IMAP_PASS=          # défaut = PROSPECT_SMTP_PASS
